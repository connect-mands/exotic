// Visitor monitoring tables only. The connection URL is supplied by
// prisma.config.ts (DATABASE_URL) and the runtime driver adapter.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WebsiteVisit {
  id             String   @id @default(cuid())
  websiteDomain  String   @db.VarChar(255)
  /// AES-256-GCM encrypted raw IP (`v1.<iv>.<tag>.<ciphertext>`). Populated only when
  /// TRAFFIC_STORE_RAW_IP=true and TRAFFIC_IP_ENCRYPTION_KEY is set; nulled after
  /// TRAFFIC_RAW_IP_RETENTION_DAYS (max 7).
  ipAddress      String?  @db.VarChar(160)
  /// HMAC-SHA256(normalized IP, TRAFFIC_IP_HASH_SECRET), hex encoded.
  ipHash         String?  @db.VarChar(64)
  sessionId      String?  @db.VarChar(64)
  /// Origin + pathname only; query strings are never stored.
  pageUrl        String   @db.VarChar(1024)
  pathname       String   @db.VarChar(512)
  landingPage    String?  @db.VarChar(512)
  /// Origin + pathname of the referrer only.
  referrer       String?  @db.VarChar(1024)
  referrerDomain String?  @db.VarChar(255)
  userAgent      String?  @db.VarChar(512)
  deviceType     String   @db.VarChar(16)
  browser        String?  @db.VarChar(32)
  gclid          String?  @db.VarChar(256)
  gbraid         String?  @db.VarChar(256)
  wbraid         String?  @db.VarChar(256)
  utmSource      String?  @db.VarChar(255)
  utmMedium      String?  @db.VarChar(255)
  utmCampaign    String?  @db.VarChar(255)
  utmTerm        String?  @db.VarChar(255)
  utmContent     String?  @db.VarChar(255)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([ipHash, createdAt])
  @@index([gclid])
  @@index([sessionId])
  @@index([websiteDomain, createdAt])
  @@index([createdAt])
}

/// Server-side admin session. Only an HMAC of the cookie token is stored, so
/// database access alone cannot recreate a valid session cookie.
model AdminSession {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique @db.VarChar(64)
  /// HMAC of the admin password at login; changing the password invalidates the session.
  passwordFingerprint String    @db.VarChar(64)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt          DateTime  @db.Timestamptz(3)
  expiresAt           DateTime  @db.Timestamptz(3)
  revokedAt           DateTime? @db.Timestamptz(3)

  @@index([expiresAt])
}

/// Admin login attempts, used for rate limiting across server instances.
/// attemptKey is the HMAC IP hash (never a raw IP) or "unknown".
model AdminLoginAttempt {
  id         String   @id @default(cuid())
  attemptKey String   @db.VarChar(64)
  success    Boolean
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([attemptKey, createdAt])
  @@index([createdAt])
}

/// Customer enquiry submitted through the website form (after WhatsApp OTP verification).
/// Kept indefinitely; delete on customer request.
model Enquiry {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  websiteDomain String   @db.VarChar(255)
  fullName      String   @db.VarChar(100)
  email         String?  @db.VarChar(254)
  mobile        String   @db.VarChar(15)
  city          String   @db.VarChar(80)
  persons       Int
  destination   String   @db.VarChar(64)
  packageId     String   @db.VarChar(128)
  /// Package title at the time of the enquiry (packages can be renamed later).
  packageName   String?  @db.VarChar(255)
  flightBooked  Boolean
  /// pending | sent | failed | not_configured
  emailStatus   String   @default("pending") @db.VarChar(16)

  @@index([createdAt])
}

/// Marker written after /api/enquiry succeeds. Contains no form data.
model WebsiteLead {
  id            String   @id @default(cuid())
  websiteDomain String   @db.VarChar(255)
  sessionId     String?  @db.VarChar(64)
  ipHash        String?  @db.VarChar(64)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([sessionId])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}
